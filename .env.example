# ============================================================
# COMETE LEARNING - Fee Management Software
# Environment variables. Copy this file to .env.local for local
# development, and set the same keys in the Vercel project's
# Environment Variables settings for production.
# NEVER commit the real .env.local file to git.
# ============================================================

# --- Supabase ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. SECRET. Server-side only. Never expose to the
# browser or commit to git. Used only inside API routes / server
# actions that must bypass RLS for controlled admin operations
# (e.g. creating auth users). Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application --------------------------------------------------
# Public base URL of the deployed app (used in emails, OAuth redirect)
NEXT_PUBLIC_APP_URL=https://app.cometelearning.com

# Organization display info used on receipts
NEXT_PUBLIC_ORG_NAME="COMETE LEARNING"

# --- Google Drive (optional at first; connect later from Settings) --
# Create these in Google Cloud Console -> APIs & Services -> Credentials
# (OAuth Client ID, type "Web application"). Authorized redirect URI:
# {NEXT_PUBLIC_APP_URL}/api/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.cometelearning.com/api/google-drive/callback

# Encryption key used to encrypt the stored Google OAuth refresh token
# at rest in the database. Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Email (optional; "Email Receipt" button is disabled until this is set) --
# Any SMTP provider works. Free/low-cost options: your own Gmail/Workspace
# account via an App Password (500/day free), or Brevo/SendinBlue's free
# tier (300 emails/day). Leave blank to keep email disabled - nothing else
# depends on it, and the app will say so plainly rather than pretend it sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="COMETE LEARNING <fees@cometelearning.com>"
